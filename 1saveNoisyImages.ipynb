    "path='C://Users//Biswarup Mistry//Desktop//NoisyImage//'  #defining the image directory path\n",
    "dir_list = os.listdir(path)\n",
    "for item in dir_list :\n",
    "    k=str(path+str(item))\n",
    "    img = imread(k)\n",
    "    \n",
    "    plt.title('Original Image : '+item)\n",
    "    plt.imshow(img,cmap=plt.cm.gray)\n",
    "    plt.show()\n"
